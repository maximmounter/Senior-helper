# Copy this file to .env and fill it in.
# Your Vercel address after you deploy the server folder (for testing on the same Wi-Fi you can use http://YOUR-MAC-IP:3000)
EXPO_PUBLIC_API_URL=https://your-project.vercel.app
# Must match APP_TOKEN in Vercel. Temporary: replaced by real sign-in before launch.
EXPO_PUBLIC_APP_TOKEN=make-up-a-long-random-password
